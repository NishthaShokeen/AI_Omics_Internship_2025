# Identify possible tar/zip of CELs
possible_tars <- list.files(raw_dir, pattern = "\\.tar$|\\.tar.gz$|\\.zip$", full.names = TRUE, ignore.case = TRUE)
has_cel_archive <- length(possible_tars) > 0

raw_affy_obj <- NULL
if (has_cel_archive) {
  message("Found archive(s). Attempting to extract CEL files and read them with ReadAffy()...")
  for (arc in possible_tars) {
    # attempt extract into Raw_Data/CEL_Files
    cel_out <- file.path(raw_dir, "CEL_Files")
    dir.create(cel_out, recursive = TRUE, showWarnings = FALSE)
    if (grepl("\\.zip$", arc, ignore.case = TRUE)) {
      tryCatch(unzip(arc, exdir = cel_out), error = function(e) message("unzip error: ", e))
    } else {
      tryCatch(untar(arc, exdir = cel_out), error = function(e) message("untar error: ", e))
    }
  }
  # Try to read CELs if any .CEL or .cel.gz present
  cel_files <- list.files(file.path(raw_dir, "CEL_Files"), pattern = "\\.CEL$|\\.cel$|\\.CEL\\.gz$|\\.cel\\.gz$", full.names = TRUE, ignore.case = TRUE)
  if (length(cel_files) > 0) {
    message("Found", length(cel_files), "CEL files. Reading with ReadAffy() ...")
    # ReadAffy expects the directory with CEL files
    tryCatch({
      raw_affy_obj <- ReadAffy(celfile.path = file.path(raw_dir, "CEL_Files"))
      message("Raw Affy object read: ", raw_affy_obj)
    }, error = function(e) {
      message("Error reading CEL files with ReadAffy(): ", e$message)
      raw_affy_obj <<- NULL
    })
  } else {
    message("No CEL files found after extraction.")
  }
} else {
  message("No compressed raw archive found in ", raw_dir, ". Proceeding using series matrix only.")
}


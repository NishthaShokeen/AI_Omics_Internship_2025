# Attempt to map to normal vs cancer. We'll look for keywords (case-insensitive).
map_to_group <- function(x) {
  xlow <- tolower(x)
  if (grepl("normal|adjacent|control|non-tumor|non tumor|para", xlow)) return("normal")
  if (grepl("tumor|tumour|cancer|adenocarcinoma|cc|carcinoma", xlow)) return("cancer")
  # fallback: return original
  return(x)
}

# -------------------------
# 4. Normalization
# -------------------------
normalized_eset <- NULL
if (!is.null(raw_affy_obj)) {
  # Perform RMA normalization on raw AffyBatch
  message("Performing RMA normalization (Affymetrix CELs present).")
  normalized_affy <- rma(raw_affy_obj)        # this returns an ExpressionSet
  normalized_eset <- normalized_affy
} else {
  # Series matrix only. Determine whether log2 transform is needed and perform quantile normalization.
  message("No raw CELs available. Performing log2 and quantile normalization (if needed) on series matrix data.")
  expr <- expr_mat_raw
  # If values look like high (>1000) assume not log2 - do log2 transform after adding small offset
  qx <- as.numeric(quantile(expr, probs = c(0.01, 0.99), na.rm = TRUE))
  if (qx[2] > 100) {
    message("Values appear unlogged (99th percentile = ", round(qx[2],1), "), applying log2(x+1) transform.")
    expr <- log2(expr + 1)
  } else {
    message("Values appear already logged (99th percentile = ", round(qx[2],1), "), skipping log transform.")
  }
  # Quantile normalization using limma::normalizeBetweenArrays
  expr_norm <- normalizeBetweenArrays(expr, method = "quantile")
  normalized_eset <- ExpressionSet(assayData = as.matrix(expr_norm))
  # Copy phenotype / feature data if available
  pData(normalized_eset) <- pheno_data
  fData(normalized_eset) <- feat_data
}


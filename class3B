# -------------------------------------------------------
#### RMA (Robust Multi-array Average) Normalization ####
# -------------------------------------------------------

# RMA is a popular method for normalizing Affymetrix microarray data by:
# 1. Background correcting,
# 2. normalizing probe intensities using quantile normalization and
# 3. summarizing them into gene-level expression values using a robust median polish algorithm.

# This method reduces experimental variation across multiple arrays,
# producing more symmetrical and reliable normalized expression data
# compared to other approaches

normalized_data <- rma(raw_data)

# QC after data normalization
if (!dir.exists("Results/QC_Normalized_Data")) {
  dir.create("Results/QC_Normalized_Data")
}

arrayQualityMetrics(expressionset = normalized_data,
                    outdir = "Results/QC_Normalized_Data",
                    force = TRUE)

# Extract normalized expression values into a data frame
processed_data <- as.data.frame(exprs(normalized_data))

dim(processed_data)    # Dimensions: number of probes × number of samples

# ---------------------------------------------------------------------------
#### Filter Low-Variance Transcripts (“soft” intensity based filtering) ####
# ---------------------------------------------------------------------------

# Filtering removes probes with low or uninformative expression signals.
# Reason: Reduces noise and improves statistical power in differential expression & Machine Learning.


# Calculate median intensity per probe across samples
row_median <- rowMedians(as.matrix(processed_data))

# Visualize distribution of probe median intensities
hist(row_median,
     breaks = 100,
     freq = FALSE,
     main = "Median Intensity Distribution")

# Set a threshold to remove low variance probes (dataset-specific, adjust accordingly)
threshold <- 3.5
abline(v = threshold, col = "black", lwd = 2)

# Select probes above threshold
indx <- row_median > threshold
filtered_data <- processed_data[indx, ]

# Rename filtered expression data with sample metadata
# Ensure the order of columns in filtered_data matches the order of rows in phenotype_data
colnames(filtered_data) <- rownames(phenotype_data)

# Overwrite processed data with filtered dataset
processed_data <- filtered_data

# -----------------------------------
#### Phenotype Data Preparation ####
# -----------------------------------

# Phenotype data contains sample-level metadata such as condition,
# tissue type, or disease status.
# Required to define experimental groups for statistical analysis.

class(phenotype_data$source_name_ch1)

# Define experimental groups based on the actual 'source_name_ch1' values for GSE235353
# You will need to inspect `levels(factor(phenotype_data$source_name_ch1))` to determine the exact levels.
# For GSE235353, common source_name_ch1 values might be 'Control' and 'Disease' or similar.
# Let's assume for this example, the levels are "human primary mesenchymal stem cell" and "human primary osteosarcoma cells" based on common biological contexts.
# Please verify these values by running `unique(phenotype_data$source_name_ch1)` after downloading the data.

# Example assuming two main groups:
# unique(phenotype_data$source_name_ch1) # Run this line to see the actual unique values
# For GSE235353, a quick check suggests values like "Human primary mesenchymal stem cell (hMSC) passage 3", "Human primary osteosarcoma cells (OS) passage 3" etc.
# We will simplify these for labeling purposes.

# Replace these with actual levels found in your data if they differ
actual_levels <- unique(phenotype_data$source_name_ch1)
print(actual_levels) # Print to console to inspect
# You might need to adjust the levels and labels based on the output of actual_levels.

# Example of defining groups (adjust 'levels' and 'labels' based on `actual_levels` output):
# Let's assume we want to compare "hMSC" vs "OS"
# You might need to refine the `grep` patterns to accurately capture your desired groups.

# Identify unique source_name_ch1 entries
source_names <- unique(phenotype_data$source_name_ch1)
print(source_names)

# Define levels and labels based on inspection of source_names
# For GSE235353, the source_name_ch1 typically contains "human primary mesenchymal stem cell" and "human primary osteosarcoma cells".
# Let's define two broad groups: "hMSC" and "OS"
# The exact string matching might need adjustment based on the actual data.
hMSC_samples <- grepl("mesenchymal stem cell", phenotype_data$source_name_ch1, ignore.case = TRUE)
OS_samples <- grepl("osteosarcoma cells", phenotype_data$source_name_ch1, ignore.case = TRUE)

# Create a new column for groups
phenotype_data$group <- NA
phenotype_data$group[hMSC_samples] <- "hMSC"
phenotype_data$group[OS_samples] <- "OS"

# Convert to factor
groups <- factor(phenotype_data$group,
                 levels = c("hMSC", "OS"),
                 labels = c("Normal", "Cancer")) # Renaming for generality, adjust if 'cancer' is not appropriate

class(groups)
levels(groups)

# You can add the 'groups' factor back to your `phenotype_data` dataframe
phenotype_data$experiment_group <- groups

# Verify the assignment
table(phenotype_data$experiment_group)


